; Copy to private/heartshop/.env OUTSIDE public/, directory 0700 and file 0600.
; INI syntax: quote values containing semicolons. Do not commit real credentials.
PAYMOVE_ENV=sandbox
PAYMOVE_API_KEY=replace-with-your-sandbox-key
PAYMOVE_PRODUCT_ID=replace-with-your-product-id
PAYMOVE_WEBHOOK_SECRET=replace-with-your-webhook-secret
SHOP_ORIGIN=https://shop.example.com
; Only with panel_origins in config.php (panel on its own host); otherwise leave unset.
;PANEL_ORIGIN=https://panel.example.com
MAIL_FROM=shop@example.com
MERCHANT_EMAIL=merchant@example.com
; Generate using php scripts/heartshop/panel-password.php
PANEL_PASSWORD_HASH=
