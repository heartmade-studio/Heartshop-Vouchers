Options -Indexes
DirectoryIndex index.html

# Seller panel on its own host: document root built by scripts/heartshop/release.php.
# Only panel.php runs here; checkout, status and webhook live on the shop host only.
RewriteEngine On
# BEGIN GENERATED HOSTS
# END GENERATED HOSTS
RewriteRule ^$ /panel/ [R=308,L]

# Never serve the rules themselves, whatever the server-wide defaults are.
<Files ".ht*">
  Require all denied
</Files>
# BEGIN GENERATED ENTRY POINTS
# END GENERATED ENTRY POINTS

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  # Short host-wide HSTS; deliberately no includeSubDomains or preload.
  Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on'"
  # The panel is never indexed.
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
